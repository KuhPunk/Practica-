<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:converters="clr-namespace:AvaloniaApplication1.Converters"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1300"
        Height="750"
        Title="АРМ работника склада"
        RequestedThemeVariant="Light">


    <Window.Resources>
        <converters:QuantityToBrushConverter x:Key="QuantityToBrushConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </Window.Resources>


    <Window.Styles>
        <Style Selector="Button.addButton">
            <Setter Property="Background" Value="#E8F5E9" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="10">

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Выход" Click="ExitMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Склад">
                <MenuItem Header="Загрузить товары" Command="{Binding LoadProductsCommand}" />
                <MenuItem Header="Добавить товар" Command="{Binding AddProductCommand}" />
                <MenuItem Header="Удалить товар" Command="{Binding DeleteProductCommand}" />
            </MenuItem>

            <MenuItem Header="_Настройки">
                <MenuItem Header="Параметры" Click="Settings_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Загрузить товары"
                        Command="{Binding LoadProductsCommand}"
                        MinWidth="150" />

                <Button Classes="addButton"
                        Command="{Binding AddProductCommand}"
                        MinWidth="150">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="+" />
                        <TextBlock Text="Добавить товар" />
                    </StackPanel>
                </Button>

                <Button Content="Удалить товар"
                        Command="{Binding DeleteProductCommand}"
                        MinWidth="140" />

                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Grid ColumnDefinitions="360,*,340"
                  RowDefinitions="Auto,*"
                  Margin="0,10,0,0"
                  ColumnSpacing="10"
                  RowSpacing="10">
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,10"
                        Padding="10"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        IsVisible="{Binding IsProductInfoVisible}"
                        Opacity="{Binding IsProductInfoVisible, Converter={StaticResource BoolToOpacityConverter}}">

                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                        </Transitions>
                    </Border.Transitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Информация о товаре"
                                   FontSize="18"
                                   FontWeight="Bold" />

                        <TextBlock Text="{Binding SelectedProduct.Name, StringFormat=Название: {0}}" />
                        <TextBlock Text="{Binding SelectedProduct.Quantity, StringFormat=Количество: {0}}" />
                        <TextBlock Text="{Binding SelectedProduct.Price, StringFormat=Цена: {0} ₽}" />
                        <TextBlock Text="{Binding SelectedProduct.CategoryEntity.Name, StringFormat=Категория: {0}}" />
                    </StackPanel>
                </Border>

                <!-- Левая панель: форма -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Данные товара"
                                   FontSize="18"
                                   FontWeight="Bold" />

                        <TextBlock Text="Название товара" />
                        <TextBox Text="{Binding ProductName, Mode=TwoWay}"
                                 Watermark="Введите название" />

                        <TextBlock Text="Количество" />
                        <TextBox Text="{Binding QuantityText, Mode=TwoWay}"
                                 Watermark="Введите количество" />

                        <TextBlock Text="Цена" />
                        <TextBox Text="{Binding PriceText, Mode=TwoWay}"
                                 Watermark="Введите цену" />

                        <TextBlock Text="Категория" />
                        <TextBox Text="{Binding ProductCategory, Mode=TwoWay}"
                                 Watermark="Введите категорию" />

                        <CheckBox IsChecked="{Binding IsLoading}"
                                  IsEnabled="False"
                                  Content="Идет загрузка" />

                        <Button Content="Загрузить товары"
                                Command="{Binding LoadProductsCommand}" />

                        <Button Classes="addButton"
                                Content="Добавить товар"
                                Command="{Binding AddProductCommand}" />

                        <Button Content="Удалить выбранный товар"
                                Command="{Binding DeleteProductCommand}" />

                        <Button x:Name="RefreshButton"
                                Content="Обновить остатки"
                                Click="RefreshStock_Click"
                                Width="170"
                                RenderTransformOrigin="50%,50%">
                            <Button.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Центр: список товаров -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Список товаров"
                                   FontSize="18"
                                   FontWeight="Bold" />

                        <ListBox ItemsSource="{Binding Products}"
                                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                 MinHeight="550"
                                 Opacity="{Binding AreProductsVisible, Converter={StaticResource BoolToOpacityConverter}}">

                            <ListBox.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                                </Transitions>
                            </ListBox.Transitions>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D8D8D8"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,8"
                                            Background="{Binding Quantity, Converter={StaticResource QuantityToBrushConverter}}">
                                        <Grid ColumnDefinitions="3*,1.4*,1.6*,2*"
                                              ColumnSpacing="10">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontWeight="Bold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity, StringFormat=Кол-во: {0}}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Price, StringFormat=Цена: {0} ₽}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CategoryEntity.Name, StringFormat=Категория: {0}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Правая панель: чат -->
                <Border Grid.Row="0"
                        Grid.Column="2"
                        Classes="card">
                </Border>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>