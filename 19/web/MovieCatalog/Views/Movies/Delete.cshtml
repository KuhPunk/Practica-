@model MovieCatalog.Models.Movie

@{
    ViewData["Title"] = "Удаление фильма";
}

<h1>@ViewData["Title"]</h1>

<h3>Вы уверены, что хотите удалить этот фильм?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Жанр</dt>
        <dd class="col-sm-10">@Model.Genre</dd>
        
        <dt class="col-sm-2">Год</dt>
        <dd class="col-sm-10">@Model.Year</dd>
        
        <dt class="col-sm-2">Рейтинг</dt>
        <dd class="col-sm-10">@Model.Rating</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>
